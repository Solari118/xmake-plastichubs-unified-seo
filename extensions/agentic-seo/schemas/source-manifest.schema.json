{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEO Source Manifest",
  "type": "object",
  "required": ["run_id", "created_at", "sources"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "source_type", "data_source", "fetched_at", "freshness_status", "confidence", "availability"],
        "properties": {
          "source_id": {"type": "string"},
          "source_type": {"type": "string"},
          "data_source": {"type": "string"},
          "fetched_at": {"type": "string"},
          "freshness_status": {"enum": ["fresh", "stale", "unknown"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "availability": {"enum": ["available", "unavailable", "partial"]},
          "reference": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

