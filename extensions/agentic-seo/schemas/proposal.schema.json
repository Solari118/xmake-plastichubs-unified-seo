{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEO Proposal",
  "type": "object",
  "required": ["proposal_id", "source_agent", "brand", "target", "action_type", "summary", "data_source", "fetched_at", "confidence", "business_value", "urgency", "effort"],
  "properties": {
    "proposal_id": {"type": "string"},
    "source_agent": {"type": "string"},
    "brand": {"enum": ["XMAKE", "PlasticHubs"]},
    "target": {"type": "string"},
    "action_type": {"type": "string"},
    "summary": {"type": "string"},
    "data_source": {"type": "string"},
    "fetched_at": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "business_value": {"type": "number", "minimum": 0},
    "urgency": {"type": "number", "minimum": 0},
    "effort": {"type": "number", "exclusiveMinimum": 0},
    "changes_search_intent": {"type": "boolean"},
    "changes_content_format": {"type": "boolean"}
  },
  "additionalProperties": true
}

