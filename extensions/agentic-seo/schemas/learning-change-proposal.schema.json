{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Governed SEO Learning Change Proposal",
  "type": "object",
  "required": [
    "proposal_id",
    "trigger",
    "target_file",
    "current_sha256",
    "before_summary",
    "after_summary",
    "proposed_patch",
    "evidence",
    "sample_size",
    "risk",
    "regression_tests",
    "rollback_point",
    "approval_status"
  ],
  "properties": {
    "proposal_id": {"type": "string"},
    "trigger": {"enum": ["30_day_review", "60_day_review", "90_day_review", "monthly_algorithm_review", "repeated_verified_failure"]},
    "target_file": {"type": "string"},
    "current_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
    "before_summary": {"type": "string"},
    "after_summary": {"type": "string"},
    "proposed_patch": {"type": "string"},
    "evidence": {"type": "array", "minItems": 1},
    "sample_size": {"type": "integer", "minimum": 1},
    "risk": {"type": "string"},
    "regression_tests": {"type": "array", "minItems": 1},
    "rollback_point": {"type": "string"},
    "approval_status": {"const": "WAITING_FOR_GOVERNANCE_APPROVAL"}
  },
  "additionalProperties": true
}
