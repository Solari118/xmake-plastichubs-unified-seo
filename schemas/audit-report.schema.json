{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit Report",
  "type": "object",
  "required": ["run_id", "artifact_version", "article_version", "verdict", "hard_gates", "reference_adaptation_check", "section_alignment_audit", "section_alignment_gate_status", "cross_article_similarity_check", "internal_link_check", "findings", "rollback_origin"],
  "properties": {
    "run_id": {"type": "string"},
    "artifact_version": {"type": "string"},
    "article_version": {"type": "string"},
    "verdict": {"enum": ["GREEN", "YELLOW", "RED", "BLOCKED"]},
    "hard_gates": {"type": "array"},
    "reference_adaptation_check": {"type": "object"},
    "section_alignment_audit": {"type": "string"},
    "section_alignment_gate_status": {"enum": ["PASS", "FAIL"]},
    "cross_article_similarity_check": {"type": "object"},
    "internal_link_check": {"type": "object"},
    "findings": {"type": "array"},
    "rollback_origin": {"enum": ["none", "info", "plan", "user"]},
    "affected_fields": {"type": "array", "items": {"type": "string"}},
    "required_replay": {"type": "array", "items": {"type": "string"}},
    "supersedes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
