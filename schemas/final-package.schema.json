{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Final Article Package",
  "type": "object",
  "required": ["run_id", "article_version", "audit_version", "verdict", "outputs", "visual_asset_manifest", "internal_link_manifest", "link_qa_status", "performance_review_schedule", "qa_status", "terminal_state"],
  "properties": {
    "run_id": {"type": "string"},
    "article_version": {"type": "string"},
    "audit_version": {"type": "string"},
    "verdict": {"const": "GREEN"},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "visual_asset_manifest": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["asset_id", "file", "placement", "alt_text"],
        "properties": {
          "asset_id": {"type": "string"},
          "file": {"type": "string"},
          "placement": {"type": "string"},
          "alt_text": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "internal_link_manifest": {"type": "string"},
    "link_qa_status": {"enum": ["Validated And Injected", "Blocked", "Not applicable"]},
    "performance_review_schedule": {"type": "array", "items": {"enum": [30, 60, 90]}},
    "qa_status": {"enum": ["Rendered QA", "Structural QA Only", "Markdown QA"]},
    "terminal_state": {"enum": ["COMPLETED", "PHASE_COMPLETED"]}
  },
  "additionalProperties": false
}
